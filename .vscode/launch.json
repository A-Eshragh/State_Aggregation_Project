                "b",
                "--cost_case",
                "high_margin",
                "--algo",
                "dfl_sketch",
                "--n_epochs",
                "50",
                "--n_samples",
                "30",
                "--lr",
                "0.005",
                "--n_agg",
                "10",
                "--aug_lag_rho",
                "1.0",
                "--seed",
                "1",
                "--n_sketches",
                "16",
                "--sketch_ratio",
                "0.6",
                "--sketch_mode",
                "gaussian",
                "--sketch_seed",
                "0"
