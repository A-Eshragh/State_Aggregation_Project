    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "train_cartpole",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_continuous.train_cartpole",
            "args": [
                "--method",
                "neural_dfl",
                "--n_iterations",
                "20",
                "--n_features",
                "128",
                "--n_trajectories",
                "1",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "all_elasticity",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_all_elasticity",
            "console": "integratedTerminal"
        },
        {
            "name": "plot_combined_comparison",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.plot_combined_comparison",
            "console": "integratedTerminal",
            "args": [
                "--diagnose-solver-grad",
                "--diagnose-panel-a",
                "--n-points",
                "5000",
                "--lam-min",
                "2.0",
                "--lam-max",
                "10.0",
                "--seed-3col",
                "1",
                "--cluster-3col",
                "10",
            ]
        },
        {
            "name": "single_elasticity_dfl_qpth",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_elasticity_experiments",
            "args": [
                "--experiment_type",
                "b",
                "--cost_case",
                "high_margin",
                "--algo",
                "dfl_qpth",
                "--n_epochs",
                "20",
                "--n_samples",
                "20",
                "--lr",
                "0.001",
                "--n_agg",
                "-1",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "single_elasticity_dfl",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_elasticity_experiments",
            "args": [
                "--experiment_type",
                "b",
                "--cost_case",
                "high_margin",
                "--algo",
                "dfl",
                "--n_epochs",
                "50",
                "--n_samples",
                "20",
                "--lr",
                "0.01",
                "--n_agg",
                "-1",
                "--seed",
                "1",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "single_elasticity_dfl_sketch",
            "type": "debugpy",
            "request": "launch",
