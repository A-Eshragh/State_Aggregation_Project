{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "all_elasticity",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_all_elasticity",
            "console": "integratedTerminal"
        },
        {
            "name": "single_elasticity_dfl_qpth",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_elasticity_experiments",
            "args": [
                "--experiment_type",
                "b",
                "--cost_case",
                "high_margin",
                "--algo",
                "dfl_qpth",
                "--n_epochs",
                "20",
                "--n_samples",
                "20",
                "--lr",
                "0.001",
                "--n_agg",
                "-1",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "single_elasticity_dfl",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_elasticity_experiments",
            "args": [
                "--experiment_type",
                "b",
                "--cost_case",
                "high_margin",
                "--algo",
                "dfl",
                "--n_epochs",
                "50",
                "--n_samples",
                "5",
                "--lr",
                "0.01",
                "--n_agg",
                "-1",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "single_elasticity_twostage",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_elasticity_experiments",
            "args": [
                "--experiment_type",
                "b",
                "--cost_case",
                "high_margin",
                "--algo",
                "twostage",
                "--n_epochs",
                "200",
                "--n_samples",
                "20",
                "--lr",
                "0.01",
                "--n_agg",
                "-1",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "single_elasticity_dfl_state_agg",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.run_elasticity_experiments",
            "args": [
                "--experiment_type",
                "b",
                "--cost_case",
                "high_margin",
                "--algo",
                "dfl",
                "--n_epochs",
                "15",
                "--n_samples",
                "20",
                "--lr",
                "0.01",
                "--n_agg",
                "10",
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "test_dfl_ope",
            "type": "debugpy",
            "request": "launch",
            "module": "mdp_lp.test_dfl_ope",
            "console": "integratedTerminal"
        },
    ]
}